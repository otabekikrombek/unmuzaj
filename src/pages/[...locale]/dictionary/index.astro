---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import dict from '../../../data/dictionary.json';
import { SECTION_AR } from '../../../config/nav';
import { useI18n, localeParams, tf, fmt, plural } from '../../../i18n';
export const getStaticPaths = localeParams;
const { locale, t } = useI18n(Astro.url);
const T = t.pages.dictionary;
const total = dict.reduce((a, g) => a + g.items.length, 0);
// перевод слова на языке страницы (r_uz…), если его нет — русский; темы пока только по-русски
const groups = dict.map(g => ({ t: g.t, items: g.items.map(w => ({ a: w.a, orig: w.r, ...tf(w, 'r', locale) })) }));
const anyRu = groups.some(g => g.items.some(w => w.ru));
---
<Base title={t.nav.dictionary} description={T.desc}>
  <PageHead title={t.nav.dictionary} ar={SECTION_AR.dictionary} lead={fmt(T.lead, { words: plural(locale, t.common.words, total), topics: plural(locale, T.topics, dict.length) })} />
  <div class="wrap">
    {anyRu && t.meta.contentInRussian && <p class="notice ru-note">{t.meta.contentInRussian}</p>}
    <label for="q">{T.search}</label>
    <input id="q" type="search" placeholder={T.placeholder} autocomplete="off" />
    <p class="muted small" id="cnt" aria-live="polite" data-found={T.found}></p>
    <div id="dict">
      {groups.map(g => (
        <section class="theme" data-topic>
          <h2 lang={locale === 'ru' ? undefined : 'ru'}>{g.t}</h2>
          <table>
            <tbody>
              {g.items.map(w => (<tr data-s={`${w.text} ${w.text === w.orig ? '' : w.orig}`} data-a={w.a}><td class="ru" lang={w.ru ? 'ru' : undefined}>{w.text}</td><td class="ar" lang="ar" dir="rtl">{w.a}</td></tr>))}
            </tbody>
          </table>
        </section>
      ))}
    </div>
  </div>
  <script>
    import { norm } from '../../../lib/normalize';
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('#dict tr')];
    const keys = rows.map(r => norm(r.dataset.s! + ' ' + r.dataset.a!));
    const q = document.getElementById('q') as HTMLInputElement, cnt = document.getElementById('cnt')!;
    function run() {
      const v = norm(q.value);
      let n = 0;
      rows.forEach((r, i) => { const ok = !v || keys[i].includes(v); r.hidden = !ok; if (ok) n++; });
      document.querySelectorAll<HTMLElement>("[data-topic]").forEach(s => { s.hidden = !s.querySelector('tr:not([hidden])'); });
      cnt.textContent = v ? cnt.dataset.found!.replace('{n}', String(n)) : '';
    }
    q.addEventListener('input', run);
    // переход из поиска по сайту: /dictionary/?q=книга
    const pre = new URLSearchParams(location.search).get('q');
    if (pre) { q.value = pre; run(); document.querySelector('#dict tr:not([hidden])')?.scrollIntoView({ block: 'center' }); }
  </script>
</Base>
<style>
  .theme { margin-top: 28px; }
  .theme h2 { font-size: 1.25rem; color: var(--accent); border-bottom: 2px solid var(--accent); padding-bottom: 4px; }
  table { width: 100%; border-collapse: collapse; }
  td { overflow-wrap: anywhere; hyphens: auto; }
  td { padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  td.ar { font-size: calc(1.45rem * var(--ar-scale)); text-align: right; width: 55%; line-height: 1.7; }
  td.ru { color: var(--ink); }
  tr:nth-child(even) td { background: var(--stripe); }
  [hidden] { display: none !important; }
  /* узкий экран и крупный шрифт: перевод над арабским словом */
  @media (max-width: 520px) {
    table, tbody, tr, td, td.ar { display: block; width: auto; }
    td.ru { border-bottom: 0; padding-bottom: 0; }
    tr:nth-child(even) { background: var(--stripe); }
    tr:nth-child(even) td { background: transparent; }
  }
</style>
