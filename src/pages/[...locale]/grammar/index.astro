---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Soon from '../../../components/Soon.astro';
import { SECTION_AR } from '../../../config/nav';
import { useI18n, localeParams, fmt } from '../../../i18n';
export const getStaticPaths = localeParams;
const { t, l } = useI18n(Astro.url);
---
<Base title={t.nav.grammar} description={t.sectionsDesc.grammar}>
  <PageHead title={t.nav.grammar} ar={SECTION_AR.grammar} lead={t.sectionsDesc.grammar} />
  <div class="wrap"><Soon><p set:html={fmt(t.common.tryExercises, { href: l('exercises/') })} /></Soon></div>
</Base>
