---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../config/site';
import { SECTION_AR } from '../../config/nav';
import { useI18n, localeParams, tf, plural } from '../../i18n';
import dictionary from '../../data/dictionary.json';
import { getVerbs } from '../../lib/verbs';
export const getStaticPaths = localeParams;
const { locale, t, l, intl } = useI18n(Astro.url);

const decks = await getCollection('decks');
const quizzes = await getCollection('quizzes');
const exercises = await getCollection('exercises');
const courses = await getCollection('courses');
const nWords = decks.reduce((a, d) => a + d.data.items.length, 0);
const nDict = dictionary.reduce((a, g) => a + g.items.length, 0);
const nVerbs = (await getVerbs()).length;

const contents = [
  { k: 'words', href: 'words/', count: `${plural(locale, t.common.decks, decks.length)} · ${plural(locale, t.common.words, nWords)}` },
  { k: 'quizzes', href: 'quizzes/', count: plural(locale, t.common.items, quizzes.filter(q => q.data.kind === 'quiz').length) },
  { k: 'tests', href: 'tests/', count: plural(locale, t.common.items, quizzes.filter(q => q.data.kind === 'test').length) },
  { k: 'exercises', href: 'exercises/', count: plural(locale, t.common.items, exercises.length) },
  { k: 'grammar', href: 'grammar/', count: t.common.soon },
  { k: 'texts', href: 'texts/', count: t.common.soon },
  { k: 'dictionary', href: 'dictionary/', count: plural(locale, t.common.words, nDict) },
  { k: 'conjugation', href: 'conjugation/', count: plural(locale, t.conj.count, nVerbs) },
  { k: 'courses', href: 'courses/', count: plural(locale, t.common.courses, courses.length) },
] as const;

const title = (d: Record<string, any>) => tf(d, 'title', locale);
const fresh = [
  ...decks.map(d => ({ ...title(d.data), added: d.data.added, href: `words/${d.data.key}/`, kind: t.kinds.deck })),
  ...quizzes.map(q => ({ ...title(q.data), added: q.data.added, href: `quizzes/${q.data.key}/`, kind: q.data.kind === 'test' ? t.kinds.test : t.kinds.quiz })),
  ...exercises.map(e => ({ ...title(e.data), added: e.data.added, href: `exercises/${e.data.key}/`, kind: t.kinds.exercise })),
].sort((a, b) => b.added.localeCompare(a.added)).slice(0, 5);

// Слова для «карточки» на первом экране (перевод — на языке страницы, если есть)
const sample = decks.flatMap(d => d.data.items).filter(w => !w.a.includes('≠')).slice(0, 60).map(w => { const r = tf(w, 'r', locale); return { a: w.a, r: r.text, f: r.ru }; });
const fmt = (d: string) => new Date(d).toLocaleDateString(intl, { day: 'numeric', month: 'long' });
const mark = t.meta.inRussian;
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="entry"><span lang="ar" dir="rtl" class="entry-ar">{SITE.nameAr}</span></p>
        <p class="gloss" set:html={t.home.gloss} />
        <h1>{t.home.h1}</h1>
        <p class="lead">{t.home.lead}</p>
        <div class="actions">
          <a class="btn" href={l('words/')}>{t.home.startWords}</a>
          <a class="btn ghost" href={l('login/#class')}>{t.home.iAmInClass}</a>
        </div>
        <p class="motto"><span lang="uz">{SITE.motto}</span>{t.meta.mottoTr && <span class="muted"> · {t.meta.mottoTr}</span>}</p>
      </div>
      <figure class="flip" aria-label={t.home.cardLabel}>
        <button class="flip-card" id="heroCard" type="button">
          <span class="fc-ar" lang="ar" dir="rtl" id="fcAr"></span>
          <span class="fc-ru" id="fcRu"></span>
          <span class="fc-hint" id="fcHint">{t.home.cardHint}</span>
        </button>
        <figcaption><button class="link" id="heroNext" type="button">{t.home.otherWord}</button> · <a href={l('words/')}>{t.home.allCards}</a></figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap">
    <h2 class="sec-h">{t.home.contents} <span lang="ar" dir="rtl" class="sec-ar">الْفِهْرِسُ</span></h2>
    <ol class="toc">
      {contents.map(c => (
        <li>
          <a href={l(c.href)}>
            <span class="toc-ru"><span class="toc-title">{t.nav[c.k]}</span><span class="toc-desc">{t.sectionsDesc[c.k]}</span></span>
            <span class="toc-dots" aria-hidden="true"></span>
            <span class="toc-count">{c.count}</span>
            <span class="toc-ar" lang="ar" dir="rtl">{SECTION_AR[c.k]}</span>
          </a>
        </li>
      ))}
    </ol>
    <form class="cform" action={l('conjugation/')} method="get">
      <label for="cv">{t.conj.homeLabel} <span lang="ar" dir="rtl" class="cform-ar">{SECTION_AR.conjugation}</span></label>
      <div class="crow">
        <input id="cv" name="v" type="search" placeholder={t.conj.homePh} autocomplete="off" spellcheck="false" />
        <button type="submit" class="btn">{t.conj.homeGo}</button>
      </div>
    </form>
  </section>

  <section class="wrap two">
    <div>
      <h2 class="sec-h">{t.home.fresh}</h2>
      <ul class="list">
        {fresh.map(f => (
          <li><a class="row" href={l(f.href)}><span class="row-title"><span lang={f.ru ? 'ru' : undefined}>{f.text}</span>{f.ru && <small class="ru-mark">{mark}</small>}</span><span class="row-side">{fmt(f.added)}</span><span class="row-meta">{f.kind}</span></a></li>
        ))}
      </ul>
      <p class="muted small" style="margin-top:10px">{t.common.gradually}</p>
    </div>
    <div>
      <h2 class="sec-h">{t.home.courses}</h2>
      <ul class="list">
        {courses.map(c => (
          <li>{(() => { const ti = tf(c.data, 'title', locale), de = tf(c.data, 'description', locale); return (
            <a class="row" href={l(`courses/${c.data.key}/`)}><span class="row-title"><span lang={ti.ru ? 'ru' : undefined}>{ti.text}</span>{(ti.ru || de.ru) && <small class="ru-mark">{mark}</small>}</span><span class="row-side">{plural(locale, t.common.tasks, c.data.items.length)}</span><span class="row-meta" lang={de.ru ? 'ru' : undefined}>{de.text}</span></a>
          ); })()}</li>
        ))}
      </ul>
    </div>
  </section>
  <script is:inline define:vars={{ sample, mark }}>
    const ar = document.getElementById('fcAr'), ru = document.getElementById('fcRu'), hint = document.getElementById('fcHint');
    const card = document.getElementById('heroCard');
    let i = Math.floor(Math.random() * sample.length), open = false;
    function show() {
      const w = sample[i], tr = document.createElement('span');
      ar.textContent = w.a; tr.textContent = w.r; ru.replaceChildren(tr);
      if (w.f) { tr.lang = 'ru'; const m = document.createElement('small'); m.className = 'ru-mark'; m.textContent = mark; ru.append(m); } // перевод ещё по-русски
      card.classList.toggle('open', open); hint.hidden = open;
    }
    card.addEventListener('click', () => { open = !open; show(); });
    document.getElementById('heroNext').addEventListener('click', () => { i = (i + 1 + Math.floor(Math.random() * (sample.length - 1))) % sample.length; open = false; show(); });
    show();
  </script>
</Base>

<style>
  .hero { background: linear-gradient(180deg, var(--hero-from) 0%, var(--paper) 100%); border-bottom: 1px solid var(--line); padding: 40px 0 48px; margin-bottom: 40px; }
  .hero-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 40px; align-items: center; }
  .entry { margin: 0; }
  .entry-ar { font-family: var(--ar); font-size: calc(clamp(3.2rem, 9vw, 5.6rem) * var(--ar-scale)); line-height: 1.75; margin-bottom: 4px; color: var(--teal); display: block; text-align: left; }
  .gloss { font-family: var(--serif); color: var(--ink-soft); border-left: 3px solid var(--gold); padding-left: 12px; max-width: 46ch; }
  .hero h1 { margin-top: 20px; }
  .lead { font-size: 1.1rem; max-width: 52ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 20px 0 18px; }
  .motto { font-family: var(--serif); font-style: italic; color: var(--teal); }
  .flip { margin: 0; text-align: center; }
  .flip-card { width: 100%; min-height: 260px; border: 0; cursor: pointer; border-radius: var(--r-m); padding: 28px 20px;
    background: var(--card-bg); color: var(--card-ink); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    box-shadow: 0 0 0 6px var(--sheet), 0 0 0 8px var(--accent-2); }
  .fc-ar { font-family: var(--ar); font-size: calc(clamp(2rem, 6vw, 2.6rem) * var(--ar-scale)); line-height: 1.6; }
  .fc-ru { font-family: var(--serif); font-size: 1.35rem; color: var(--card-accent); visibility: hidden; }
  .flip-card.open .fc-ru { visibility: visible; }
  .fc-hint { font-size: .9rem; opacity: .75; }
  .flip figcaption { margin-top: 18px; font-size: .95rem; }
  .link { background: none; border: 0; color: var(--lapis); text-decoration: underline; font: inherit; cursor: pointer; padding: 6px; min-height: 44px; }
  .sec-h { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  .sec-ar { font-family: var(--ar); color: var(--turq); font-weight: 400; font-size: calc(1.5rem * var(--ar-scale)); }
  .toc { list-style: none; padding: 0; margin: 0 0 48px; counter-reset: none; }
  .toc a { display: grid; grid-template-columns: auto 1fr auto auto; align-items: end; gap: 12px; padding: 16px 4px; text-decoration: none; color: inherit; border-bottom: 1px solid var(--line); }
  .toc li:first-child a { border-top: 2px solid var(--teal); }
  .toc a:hover { background: var(--hover); }
  .toc-ru { display: flex; flex-direction: column; }
  .toc-title { font-family: var(--serif); font-size: 1.3rem; font-weight: 700; color: var(--ink); }
  .toc-desc { color: var(--ink-soft); font-size: .95rem; }
  .toc-dots { border-bottom: 2px dotted var(--line-strong); margin-bottom: 8px; min-width: 20px; }
  .toc-count { color: var(--ink-soft); font-size: .92rem; white-space: nowrap; padding-bottom: 2px; }
  .toc-ar { font-family: var(--ar); font-size: calc(1.7rem * var(--ar-scale)); color: var(--teal); min-width: 7.5em; text-align: right; line-height: 1.3; }
  .cform { margin: -24px 0 48px; max-width: 640px; }
  .cform label { font-family: var(--serif); font-size: 1.15rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .cform-ar { font-family: var(--ar); font-weight: 400; color: var(--turq); font-size: calc(1.3rem * var(--ar-scale)); }
  .crow { display: flex; gap: 8px; }
  .crow input { flex: 1; min-width: 0; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  @media (max-width: 820px) {
    .hero-grid, .two { grid-template-columns: 1fr; }
    .toc a { grid-template-columns: 1fr auto; }
    .toc-dots { display: none; }
    .toc-ar { grid-column: 2; grid-row: 1; min-width: 0; font-size: calc(1.4rem * var(--ar-scale)); }
    .toc-count { grid-column: 1 / -1; }
  }
</style>
