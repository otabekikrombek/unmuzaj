    });
    // ячейка CSV; текст, начинающийся с = + - @, Excel принял бы за формулу — перед ним ставится апостроф
    const csvCell = (v: unknown) => { const t = String(v ?? ''); return '"' + (typeof v === 'string' && /^[=+\-@\t\r]/.test(t) ? "'" + t : t).replace(/"/g, '""') + '"'; };
    function download(rows: unknown[][], name: string) {
      const csv = '\ufeff' + rows.map(r => r.map(csvCell).join(';')).join('\r\n');
      const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' })); a.download = name; a.click();
    }
    $('csv').addEventListener('click', () => {
      if (!R) return;
      const head = [T.csvCode, ...COLS.map(c => c[1])];
      const rows = (R.learners as any[]).map(s => [s.code, ...COLS.map(c => { const v = c[2](s); return c[0] === 'last' ? (v ? new Date(v).toLocaleString(D.intl) : '') : v ?? ''; })]);
      const csv = '﻿' + [head, ...rows].map(r => r.map(csvCell).join(';')).join('\r\n');
      const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' })); a.download = `allimni_${cur?.join || 'class'}.csv`; a.click();
    });

    // ---------- вкладки, администратор ----------
    document.querySelectorAll<HTMLElement>('[data-tab]').forEach(b => b.addEventListener('click', () => {
      document.querySelectorAll('[data-tab]').forEach(x => x.setAttribute('aria-selected', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach(p => (p.hidden = p.dataset.panel !== b.dataset.tab));
    }));
    $('roleForm').addEventListener('submit', async e => {
      e.preventDefault();
      const r = await rpc<any>('admin_set_role', { p_email: $<HTMLInputElement>('rEmail').value, p_role: $<HTMLSelectElement>('rRole').value });
      $('rMsg').textContent = r.ok ? T.roleSaved : r.err === 'no_user' ? T.noUser : T.roleFail;
    });
    boot();
  </script>
</Base>

<style>
  .tp { padding-top: 24px; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .bar h1 { margin: 0; }
  .sm { min-height: 40px; padding: 0 12px; font-size: .92rem; }
  .sr { position: absolute; left: -9999px; }
  .classrow { display: flex; gap: 10px; margin: 16px 0; align-items: center; }
  .classrow select { max-width: 460px; }
  .box { background: var(--sheet); border: 1px solid var(--line); border-radius: var(--r-m); padding: 16px 18px; margin-bottom: 16px; }
  .box h2 { font-size: 1.2rem; }
  .grid3 { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 12px; }
  .tabs { display: flex; gap: 6px; border-bottom: 2px solid var(--accent); margin: 8px 0 18px; flex-wrap: wrap; }
  .tabs button { border: 0; background: transparent; min-height: 44px; padding: 0 14px; font: 600 1rem var(--sans); color: var(--ink-soft); cursor: pointer; border-radius: 8px 8px 0 0; }
  .tabs button[aria-selected='true'] { background: var(--accent); color: var(--on-accent); }
  .filters { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
  .filters label { margin: 0; } .filters select { width: auto; }
  .acts { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .num { width: 70px !important; }
  .classinfo .join { font-size: 1.3rem; letter-spacing: .08em; color: var(--lapis); }
  .tp :global(.tw), dialog :global(.tw) { overflow-x: auto; max-width: 100%; }
  .tp :global(table), dialog :global(table) { border-collapse: collapse; width: 100%; font-size: .95rem; }
  .tp :global(th), .tp :global(td), dialog :global(th), dialog :global(td) { padding: 7px 8px; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
  .tp :global(th), dialog :global(th) { background: var(--accent); color: var(--on-accent); font-size: .85rem; }
  .tp :global(table.words td:nth-child(2)) { white-space: normal; min-width: 140px; }
  #people input[type=text], #people select { min-height: 38px; padding: 4px 8px; }
  #qzRep :global(.kpis), #report :global(.kpis) { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 20px; }
