---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
export async function getStaticPaths() {
  return (await getCollection('courses')).map(c => ({ params: { course: c.data.key }, props: { c: c.data } }));
}
const { c } = Astro.props;
const decks = Object.fromEntries((await getCollection('decks')).map(d => [d.data.key, d.data]));
const quizzes = Object.fromEntries((await getCollection('quizzes')).map(d => [d.data.key, d.data]));
const exercises = Object.fromEntries((await getCollection('exercises')).map(d => [d.data.key, d.data]));
const kindName = { deck: 'Слова', quiz: 'Викторина', test: 'Тест', exercise: 'Упражнение', grammar: 'Грамматика', text: 'Текст' } as const;
const steps = c.items.map(it => {
  const d = it.kind === 'deck' ? decks[it.key] : it.kind === 'exercise' ? exercises[it.key] : quizzes[it.key];
  const href = it.kind === 'deck' ? `words/${it.key}/` : it.kind === 'exercise' ? `exercises/${it.key}/` : `quizzes/${it.key}/`;
  return { title: d?.title ?? it.key, desc: d?.description ?? '', kind: kindName[it.kind], href, note: it.note };
});
---
<Base title={c.title} description={c.description}>
  <PageHead title={c.title} ar="الْمُقَرَّرُ" lead={c.description}>{c.audience && <p class="small muted">Для кого: {c.audience}</p>}</PageHead>
  <div class="wrap narrow">
    <ol class="steps">
      {steps.map(s => (
        <li><a href={u(s.href)}><span class="k">{s.kind}</span><span class="t">{s.title}</span><span class="d">{s.desc}</span></a></li>
      ))}
    </ol>
  </div>
</Base>
<style>
  .steps { padding-left: 2.2em; margin: 0; }
  .steps li { padding: 4px 0; border-bottom: 1px solid var(--line); }
  .steps li::marker { font-family: var(--serif); font-weight: 700; color: var(--turq); }
  .steps a { display: grid; padding: 12px 4px; text-decoration: none; color: inherit; }
  .steps a:hover { background: #e9f2ef; }
  .k { font-size: .85rem; color: var(--turq); }
  .t { font-family: var(--serif); font-weight: 700; font-size: 1.15rem; }
  .d { color: var(--ink-soft); font-size: .95rem; }
</style>
