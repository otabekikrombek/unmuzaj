---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ItemList from '../../components/ItemList.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ru';
const c = await getCollection('courses');
---
<Base title={t.nav.courses} description="Курсы арабского языка: задания по порядку.">
  <PageHead title={t.nav.courses} ar={t.sectionsAr.courses} lead={t.sectionsDesc.courses} />
  <div class="wrap"><ItemList items={c.map(x => ({ title: x.data.title, href: `courses/${x.data.key}/`, side: `${x.data.items.length} заданий`, meta: x.data.description }))} /></div>
</Base>
