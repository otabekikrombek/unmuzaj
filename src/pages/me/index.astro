---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
const quizMeta = Object.fromEntries((await getCollection('quizzes')).map(q => [q.data.key, { title: q.data.title, href: u(`quizzes/${q.data.key}/`),
  plan: q.data.plan, sections: q.data.sections, explain: Object.fromEntries(q.data.pool.map(p => [p.id, p.e])) }]));
const decks = (await getCollection('decks')).map(d => ({ key: d.data.key, title: d.data.title, n: d.data.items.length, href: u(`words/${d.data.key}/`) }));
---
<Base title="Мой прогресс" noindex>
  <PageHead title="Мой прогресс" ar="تَقَدُّمِي" />
  <div class="wrap narrow" id="me"><p>Загрузка…</p></div>
  <script type="application/json" id="me-data" set:html={JSON.stringify({ decks, quizMeta, login: u('login/'), home: u(''), teacher: u('teacher/') })} />
  <script>
    import { getWho, rpc, token, logout, AuthError } from '../../lib/api';
    import { flushQuizzes } from '../../lib/quizStore';
    import { reviewHTML, secBars, fmtTime } from '../../lib/quizView';
    import { t } from '../../i18n/ru';
    const D = JSON.parse(document.getElementById('me-data')!.textContent!);
    const box = document.getElementById('me')!;
    const esc = (s: unknown) => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    const who = getWho();
    if (!who) box.innerHTML = `<p>Вы занимаетесь как гость: прогресс хранится только на этом устройстве.</p><p><a class="btn" href="${D.login}">Войти</a></p>`;
    else load();
    async function load() {
      const head = who!.kind === 'pin' ? `<p><b>${esc(who!.nickname)}</b> · класс «${esc(who!.className)}» · код ${esc(who!.code)}</p>` : `<p><b>${esc(who!.email)}</b></p>`;
      try {
        await flushQuizzes(); // сначала отправить неотправленные попытки
        const o = await rpc<any>('my_overview', { p_token: token() });
        const rows = D.decks.map((d: any) => { const s = o.decks[d.key] || {}; const known = (s.good || 0) + (s.done || 0);
          return `<li><a class="row" href="${d.href}"><span class="row-title">${esc(d.title)}</span><span class="row-side">знаю ${known} из ${d.n}</span><span class="row-meta">видел ${s.seen || 0} · учу ${s.learn || 0} · выучено ${s.done || 0}</span></a></li>`; }).join('');
        const tests = o.tests.length ? `<ul>${o.tests.map((t: any) => `<li>${new Date(t.at).toLocaleDateString('ru-RU')} — ${t.correct} из ${t.total}</li>`).join('')}</ul>` : '<p class="muted">Тестов пока нет.</p>';
        const QM = D.quizMeta;
        const quizzes = o.quizzes?.length ? `<ul class="qlist">${o.quizzes.map((a: any) => `<li><a href="${QM[a.quiz]?.href || '#'}">${esc(QM[a.quiz]?.title || a.quiz)}</a> — ${new Date(a.at).toLocaleDateString('ru-RU')}: <b>${a.correct} из ${a.total}</b>, ${a.points} очков, ${fmtTime(a.time || 0)} <button class="btn ghost sm" data-quiz="${esc(a.quiz)}" data-id="${esc(a.id)}">Разбор</button></li>`).join('')}</ul>` : '<p class="muted">Викторин пока нет.</p>';
        box.innerHTML = head + `<p>Всего занятий: <b>${o.visits}</b> · активное время: <b>${o.minutes}</b> мин.</p><h2>Слова</h2><ul class="list">${rows}</ul><h2 style="margin-top:28px">Последние тесты по словам</h2>${tests}<h2 style="margin-top:28px">Викторины</h2>${quizzes}<div id="rvBox"></div>` +
          (who!.kind === 'email' && /teacher|admin/.test((who as any).role) ? `<p><a class="btn" href="${D.teacher}">Панель учителя</a></p>` : '') +
          `<p style="margin-top:28px"><button class="btn ghost" id="out">Выйти</button></p>`;
      } catch (e) {
        box.innerHTML = head + (e instanceof AuthError ? `<p>Вход устарел. <a href="${D.login}">Войдите снова</a>.</p>` : '<p>Нет связи. Попробуйте позже.</p>') + `<p><button class="btn ghost" id="out">Выйти</button></p>`;
      }
      box.querySelectorAll<HTMLButtonElement>('[data-quiz]').forEach(b => b.addEventListener('click', async () => {
        const rv = document.getElementById('rvBox')!; rv.innerHTML = '<p>Загрузка…</p>';
        try {
          const list = await rpc<any[]>('quiz_my_attempts', { p_token: token(), p_quiz: b.dataset.quiz });
          const a = list.find(x => x.id === b.dataset.id), m = D.quizMeta[b.dataset.quiz!];
          if (!a || !m) throw 0;
          const secRows = (m.plan as [string, number][]).map(([k]) => { const x = (a.answers as any[]).filter(y => y.s === k); return { s: k, ok: x.filter(y => y.ok).length, n: x.length }; }).filter(x => x.n);
          rv.innerHTML = `<h3>${esc(m.title)} · ${new Date(a.at).toLocaleString('ru-RU')}</h3>` + (secRows.length > 1 ? secBars(m.sections, secRows) : '') + reviewHTML(a.answers, m.sections, t.quiz, m.explain);
          rv.scrollIntoView({ behavior: 'smooth' });
        } catch { rv.innerHTML = '<p>Не удалось загрузить разбор.</p>'; }
      }));
      document.getElementById('out')?.addEventListener('click', async () => { await logout(); location.href = D.home; });
    }
  </script>
</Base>

<style>
  .qlist { padding-left: 20px; }
  .qlist li { margin: 6px 0; }
  .sm { min-height: 44px; padding: 0 12px; font-size: .92rem; margin-left: 6px; }
  #rvBox :global(.ar) { font-family: var(--ar); }
</style>
