---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ItemList from '../../components/ItemList.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ru';
const q = (await getCollection('quizzes')).filter(x => x.data.kind === 'quiz').sort((a, b) => a.data.key.localeCompare(b.data.key));
---
<Base title={t.nav.quizzes} description="Викторины по арабскому языку: тексты уроков, лексика, грамматика.">
  <PageHead title={t.nav.quizzes} ar={t.sectionsAr.quizzes} lead={t.sectionsDesc.quizzes} />
  <div class="wrap">
    <ItemList items={q.map(x => ({ title: x.data.title, href: `quizzes/${x.data.key}/`, side: x.data.level, meta: x.data.description }))} />
  </div>
</Base>
