---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
import { SITE } from '../../config/site';
import { t } from '../../i18n/ru';
const FA = t.feedbackAdmin;
const decks = await getCollection('decks');
const quizzes = (await getCollection('quizzes')).map(q => q.data).sort((a, b) => b.added.localeCompare(a.added));
// данные викторин для разбора: названия частей и пояснения к вопросам
const quizMeta = Object.fromEntries(quizzes.map(q => [q.key, { title: q.title, kind: q.kind, plan: q.plan, sections: q.sections,
  explain: Object.fromEntries(q.pool.map(p => [p.id, p.e])) }]));
const dict: Record<string, string> = {};
const deckNames: Record<string, string> = {};
decks.forEach(d => { deckNames[d.data.key] = d.data.title; d.data.items.forEach(i => (dict[d.data.key + '|' + i.a] = i.r)); });
const siteUrl = new URL(u(''), Astro.site).href;
---
<Base title="Панель учителя" noindex>
  <div class="wrap tp">
    <div id="gate"><p>Загрузка…</p></div>
    <div id="app" hidden>
      <div class="bar">
        <h1>Панель учителя</h1>
        <div class="bar-r"><span id="me" class="muted small"></span> <button class="btn ghost sm" id="logout">Выйти</button></div>
      </div>
      <div class="classrow">
        <label for="cls" class="sr">Класс</label>
        <select id="cls"></select>
        <button class="btn ghost sm" id="newClsBtn">+ Новый класс</button>
      </div>
      <form id="newCls" class="box" hidden>
        <h2>Новый класс</h2>
        <div class="grid3">
          <div><label for="ncName">Название</label><input id="ncName" type="text" placeholder="2 курс ТГУВ, группа 1" required /></div>
          <div><label for="ncYear">Учебный год</label><input id="ncYear" type="text" placeholder="2026–2027" /></div>
          <div><label for="ncCount">Сколько учеников</label><input id="ncCount" type="text" inputmode="numeric" value="19" /></div>
        </div>
        <p class="muted small">Ученикам будут выданы коды 01, 02, … и случайные ПИН. ПИН показываются <b>один раз</b> — сразу распечатайте лист с ПИН.</p>
        <button class="btn" type="submit">Создать класс</button>
      </form>

      <div class="tabs" role="tablist">
        <button data-tab="stats" aria-selected="true">Статистика</button>
        <button data-tab="quizzes" aria-selected="false">Викторины</button>
        <button data-tab="people" aria-selected="false">Ученики и ПИН</button>
        <button data-tab="messages" aria-selected="false" id="msgTab" hidden>{FA.tab} <span class="badge" id="msgBadge" hidden></span></button>
        <button data-tab="admin" aria-selected="false" id="adminTab" hidden>Администратор</button>
      </div>

      <section data-panel="stats">
        <div class="filters">
          <label for="period">Период</label>
          <select id="period">
            <option value="7">Последние 7 дней</option>
            <option value="30">Последние 30 дней</option>
            <option value="sem" selected>С 1 сентября</option>
            <option value="all">Всё время</option>
          </select>
          <button class="btn ghost sm" id="reload">Обновить</button>
          <button class="btn ghost sm" id="csv">Скачать таблицу (CSV)</button>
          <button class="btn ghost sm" onclick="print()">Печать</button>
        </div>
        <div id="report"><p class="muted">Выберите класс.</p></div>
      </section>

      <section data-panel="quizzes" hidden>
        <div class="filters">
          <label for="qzSel">Викторина</label>
          <select id="qzSel"></select>
          <a class="btn ghost sm" id="qzBoard" target="_blank" rel="noopener">Табло для проектора ↗</a>
          <button class="btn ghost sm" id="qzCsv">Все ответы (CSV)</button>
        </div>
        <p class="muted small">Период — тот же, что во вкладке «Статистика». Табло показывает только псевдонимы и лучший результат каждого за 3 часа; откройте его на компьютере у проектора.</p>
        <div id="qzRep"><p class="muted">Выберите класс.</p></div>
      </section>

      <section data-panel="people" hidden>
        <div class="box">
          <p class="classinfo" id="classInfo"></p>
          <div class="acts">
            <label for="addN" class="sr">Сколько добавить</label>
            <input id="addN" type="text" inputmode="numeric" value="1" class="num" />
            <button class="btn ghost sm" id="addBtn">Добавить учеников</button>
            <button class="btn ghost sm" id="resetSel">Новый ПИН отмеченным</button>
            <button class="btn ghost sm" id="namesBtn">Настоящие имена…</button>
          </div>
          <p class="muted small">Настоящие имена хранятся только в этом браузере, не на сервере. Чтобы видеть их на другом компьютере, вставьте список и там.</p>
        </div>
        <div class="tw"><table id="people"></table></div>
        <form id="namesForm" class="box" hidden>
          <h2>Настоящие имена (только на этом компьютере)</h2>
          <p class="muted small">По одной строке: код; имя и фамилия. Например: <code>07; Азиза Каримова</code></p>
          <textarea id="namesTxt" rows="10"></textarea>
          <button class="btn" type="submit">Сохранить</button>
        </form>
      </section>

      <section data-panel="messages" hidden>
        <div class="filters">
          <label for="msgFilter">{FA.show}</label>
          <select id="msgFilter">
            <option value="new">{FA.filters.new}</option>
            <option value="read">{FA.filters.read}</option>
            <option value="fixed">{FA.filters.fixed}</option>
            <option value="">{FA.filters.all}</option>
          </select>
          <button class="btn ghost sm" id="msgReload">{FA.reload}</button>
        </div>
        <p class="muted small">{FA.hint}</p>
        <div id="msgList"></div>
      </section>

      <section data-panel="admin" hidden>
        <form id="roleForm" class="box">
          <h2>Сделать пользователя учителем</h2>
          <p class="muted small">Пользователь сначала должен быть создан в Supabase → Authentication → Users.</p>
          <div class="grid3">
            <div><label for="rEmail">Email</label><input id="rEmail" type="email" required /></div>
            <div><label for="rRole">Роль</label><select id="rRole"><option value="teacher">учитель</option><option value="user">обычный пользователь</option><option value="admin">администратор</option></select></div>
            <div style="align-self:end"><button class="btn" type="submit">Сохранить</button></div>
          </div>
          <p class="msg" id="rMsg"></p>
        </form>
      </section>
    </div>
  </div>

  <div id="print" aria-hidden="true"></div>
  <dialog id="dlg"><div class="dh"><h2 id="dt"></h2><button class="btn ghost sm" id="dclose">Закрыть</button></div><div class="db" id="dbody"></div></dialog>
  <dialog id="pins"><div class="dh"><h2>ПИН учеников</h2><button class="btn ghost sm" id="pclose">Закрыть</button></div>
    <div class="db"><p><b>Распечатайте или перепишите сейчас:</b> после закрытия окна ПИН больше не будет видно (в базе хранится только зашифрованный вариант). Если потеряете — выдайте новый ПИН.</p>
    <div id="pinList"></div><p><button class="btn" id="pprint">Печать листа с ПИН</button></p></div></dialog>

  <script type="application/json" id="tp-data" set:html={JSON.stringify({ dict, deckNames, quizMeta, login: u('login/') + '?next=' + u('teacher/'), site: siteUrl, siteName: SITE.name, home: u('') })} />
  <script>
    import { getWho, rpc, logout, sb } from '../../lib/api';
    import { secBars, reviewHTML, wrapAr, fmtTime } from '../../lib/quizView';
    import { t } from '../../i18n/ru';
    const D = JSON.parse(document.getElementById('tp-data')!.textContent!);
    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    let classes: any[] = [], cur: any = null, R: any = null, QR: any = null, sortK = 'known', sortD = -1;

    // ---------- вход ----------
    const who = getWho();
    async function boot() {
      if (!who || who.kind !== 'email') { $('gate').innerHTML = `<h1>Панель учителя</h1><p>Войдите по email учителя.</p><p><a class="btn" href="${D.login}">Войти</a></p>`; return; }
      try {
        const s = await sb().auth.getSession();
        if (!s.data.session) throw new Error('no session');
        const r = await rpc<any>('teacher_classes');
        if (!r.ok) { $('gate').innerHTML = `<h1>Панель учителя</h1><p>У аккаунта ${esc(who.email)} нет прав учителя. Обратитесь к администратору сайта.</p>`; return; }
        classes = r.classes; $('adminTab').hidden = !r.admin; $('msgTab').hidden = !r.admin;
        if (r.admin) loadMsgs();
        $('gate').hidden = true; $('app').hidden = false; $('me').textContent = who.email;
        fillClasses();
      } catch { $('gate').innerHTML = `<h1>Панель учителя</h1><p>Вход устарел или нет связи.</p><p><a class="btn" href="${D.login}">Войти снова</a></p>`; }
    }
    $('logout').addEventListener('click', async () => { await logout(); location.href = D.home; });

    // ---------- классы ----------
    function fillClasses(selectId?: number) {
      const s = $<HTMLSelectElement>('cls');
      s.innerHTML = classes.length ? classes.map(c => `<option value="${c.id}">${esc(c.name)}${c.year ? ' · ' + esc(c.year) : ''}${c.archived ? ' (архив)' : ''}</option>`).join('') : '<option value="">— классов пока нет —</option>';
      if (selectId) s.value = String(selectId);
      if (!classes.length) { $('newCls').hidden = false; }
      pick();
    }
    function pick() {
      cur = classes.find(c => String(c.id) === $<HTMLSelectElement>('cls').value) || null;
      people(); loadReport();
    }
    $('cls').addEventListener('change', pick);
    $('newClsBtn').addEventListener('click', () => { $('newCls').hidden = !$('newCls').hidden; });
    $('newCls').addEventListener('submit', async e => {
      e.preventDefault();
      const name = $<HTMLInputElement>('ncName').value.trim(), year = $<HTMLInputElement>('ncYear').value.trim(), n = parseInt($<HTMLInputElement>('ncCount').value) || 0;
      if (!name) return;
      const r = await rpc<any>('teacher_create_class', { p_name: name, p_year: year || null });
      if (!r.ok) return alert('Не удалось создать класс');
      let pins: any[] = [];
      if (n > 0) { const a = await rpc<any>('teacher_add_learners', { p_class: r.id, p_count: Math.min(60, n) }); pins = a.learners || []; }
      classes = (await rpc<any>('teacher_classes')).classes; $('newCls').hidden = true; fillClasses(r.id);
      if (pins.length) showPins(pins);
    });

    // ---------- имена (только локально) ----------
    const namesKey = () => `unmuzaj:names:${cur?.id}`;
    function names(): Record<string, string> { try { return JSON.parse(localStorage.getItem(namesKey()) || '{}'); } catch { return {}; } }
    const label = (l: { code: string; nickname: string }) => names()[l.code] || l.nickname;
    $('namesBtn').addEventListener('click', () => {
      const n = names(); $<HTMLTextAreaElement>('namesTxt').value = (cur?.learners || []).map((l: any) => `${l.code}; ${n[l.code] || ''}`).join('\n');
      $('namesForm').hidden = false; $('namesTxt').focus();
    });
    $('namesForm').addEventListener('submit', e => {
      e.preventDefault();
      const m: Record<string, string> = {};
      $<HTMLTextAreaElement>('namesTxt').value.split('\n').forEach(line => { const [c, ...rest] = line.split(/[;,\t]/); const code = (c || '').replace(/\D/g, '').padStart(2, '0'); const nm = rest.join(' ').trim(); if (code !== '00' && nm) m[code] = nm; });
      try { localStorage.setItem(namesKey(), JSON.stringify(m)); } catch {}
      $('namesForm').hidden = true; people(); if (R) { renderReport(); quizPart(); }
    });

    // ---------- ученики ----------
    function people() {
      if (!cur) { $('people').innerHTML = ''; $('classInfo').textContent = ''; return; }
      $('classInfo').innerHTML = `Код класса для учеников: <b class="join">${esc(cur.join)}</b> · вход: <a href="${D.site}login/">${esc(D.site)}login/</a>`;
      const n = names();
      $('people').innerHTML = `<thead><tr><th><input type="checkbox" id="allChk" aria-label="Отметить всех"></th><th>Код</th><th>Имя (только у вас)</th><th>Псевдоним (видят другие)</th><th>Пол</th><th>Активен</th><th></th></tr></thead><tbody>` +
        cur.learners.map((l: any) => `<tr data-id="${l.id}"><td><input type="checkbox" class="chk" aria-label="Отметить ${esc(l.code)}"></td><td>${esc(l.code)}</td><td>${esc(n[l.code] || '—')}</td>
          <td><input type="text" class="nick" value="${esc(l.nickname)}" maxlength="40" aria-label="Псевдоним ${esc(l.code)}"></td>
          <td><select class="sex" aria-label="Пол ${esc(l.code)}"><option value="">—</option><option ${l.sex === 'м' ? 'selected' : ''}>м</option><option ${l.sex === 'ж' ? 'selected' : ''}>ж</option></select></td>
          <td><input type="checkbox" class="act" ${l.active ? 'checked' : ''} aria-label="Активен ${esc(l.code)}"></td><td><button class="btn ghost sm save">Сохранить</button></td></tr>`).join('') + '</tbody>';
      $('allChk')?.addEventListener('change', e => document.querySelectorAll<HTMLInputElement>('.chk').forEach(c => (c.checked = (e.target as HTMLInputElement).checked)));
      document.querySelectorAll<HTMLButtonElement>('#people .save').forEach(b => b.addEventListener('click', async () => {
        const tr = b.closest('tr')!, id = +tr.dataset.id!;
        const r = await rpc<any>('teacher_update_learner', { p_id: id, p_nickname: (tr.querySelector('.nick') as HTMLInputElement).value, p_sex: (tr.querySelector('.sex') as HTMLSelectElement).value || null, p_active: (tr.querySelector('.act') as HTMLInputElement).checked });
        b.textContent = r.ok ? 'Сохранено ✓' : 'Ошибка'; setTimeout(() => (b.textContent = 'Сохранить'), 1500);
        classes = (await rpc<any>('teacher_classes')).classes; cur = classes.find(c => c.id === cur.id);
      }));
    }
    $('addBtn').addEventListener('click', async () => {
      if (!cur) return; const n = Math.min(60, parseInt($<HTMLInputElement>('addN').value) || 0); if (!n) return;
      const a = await rpc<any>('teacher_add_learners', { p_class: cur.id, p_count: n });
      classes = (await rpc<any>('teacher_classes')).classes; cur = classes.find(c => c.id === cur.id); people();
      if (a.ok) showPins(a.learners);
    });
    $('resetSel').addEventListener('click', async () => {
      const ids = [...document.querySelectorAll<HTMLInputElement>('.chk:checked')].map(c => +c.closest('tr')!.dataset.id!);
      if (!ids.length) return alert('Отметьте учеников галочкой.');
      if (!confirm(`Выдать новый ПИН ${ids.length} ученикам? Старые ПИН перестанут работать.`)) return;
      const a = await rpc<any>('teacher_reset_pins', { p_ids: ids });
      if (a.ok) showPins(a.learners);
    });
    function showPins(list: any[]) {
      const n = names();
      $('pinList').innerHTML = `<table class="pins"><thead><tr><th>Код</th><th>Имя</th><th>ПИН</th></tr></thead><tbody>${list.map(l => `<tr><td>${esc(l.code)}</td><td>${esc(n[l.code] || l.nickname)}</td><td class="pin">${esc(l.pin)}</td></tr>`).join('')}</tbody></table>`;
      $('print').innerHTML = `<div class="strips">${list.map(l => `<div class="strip"><p class="s-site">${esc(D.siteName)} · ${esc(D.site)}login/</p><p class="s-name">${esc(n[l.code] || l.nickname)}</p>
        <p class="s-row"><span>Код класса<b>${esc(cur.join)}</b></span><span>Мой код<b>${esc(l.code)}</b></span><span>ПИН<b>${esc(l.pin)}</b></span></p></div>`).join('')}</div>`;
      $<HTMLDialogElement>('pins').showModal();
    }
    $('pclose').addEventListener('click', () => { if (confirm('Вы распечатали или записали ПИН? После закрытия их не будет видно.')) { $<HTMLDialogElement>('pins').close(); $('print').innerHTML = ''; } });
    // Печать в отдельном окне: в нём только полоски с ПИН, без интерфейса панели.
    // Цвета здесь намеренно постоянные (лист печатается чёрным по белому при любой теме сайта).
    $('pprint').addEventListener('click', () => {
      const html = `<!doctype html><html lang="ru"><head><meta charset="utf-8"><title>ПИН учеников — ${esc(cur?.name || '')}</title><style>
        @page { size: A4 portrait; margin: 10mm; }
        body { margin: 0; font-family: Georgia, 'Times New Roman', serif; color: #111; }
        .hint { font: 13px Arial, sans-serif; margin: 0 0 8px; }
        .strips { display: grid; grid-template-columns: 1fr 1fr; }
        .strip { border: 1px dashed #777; padding: 10px 12px; break-inside: avoid; page-break-inside: avoid; min-height: 50mm; box-sizing: border-box; }
        .strip p { margin: 0 0 4px; }
        .s-site { font: 9pt Arial, sans-serif; color: #333; }
        .s-name { font-weight: 700; font-size: 14pt; }
        .s-row { display: flex; gap: 18px; margin-top: 10px !important; }
        .s-row span { font: 9pt Arial, sans-serif; display: flex; flex-direction: column; }
        .s-row b { font: 700 18pt Georgia, serif; letter-spacing: .05em; }
        @media print { .hint { display: none; } }
      </style></head><body><p class="hint">Если печать не открылась сама — нажмите Ctrl+P (на телефоне: «Поделиться» → «Печать» или «Сохранить в Файлы»).</p>${$('print').innerHTML}</body></html>`;
      const w = window.open('', '_blank');
      if (!w) { alert('Браузер заблокировал новое окно. Разрешите всплывающие окна для этого сайта и нажмите кнопку ещё раз.'); return; }
      w.document.open(); w.document.write(html); w.document.close();
      w.focus(); setTimeout(() => w.print(), 400);
    });

    // ---------- отчёт ----------
    function periodFrom() {
      const v = $<HTMLSelectElement>('period').value, now = new Date();
      if (v === 'all') return '2000-01-01T00:00:00Z';
      if (v === 'sem') { const y = now.getMonth() >= 8 ? now.getFullYear() : now.getFullYear() - 1; return `${y}-09-01T00:00:00+05:00`; }
      return new Date(Date.now() - +v * 864e5).toISOString();
    }
    async function loadReport() {
      if (!cur) { $('report').innerHTML = '<p class="muted">Создайте класс.</p>'; $('qzRep').innerHTML = ''; return; }
      $('report').innerHTML = '<p class="muted">Загрузка…</p>';
      try {
        [R, QR] = await Promise.all([rpc<any>('teacher_report', { p_class: cur.id, p_from: periodFrom() }), rpc<any>('teacher_quiz_report', { p_class: cur.id, p_from: periodFrom() })]);
        renderReport(); renderQuizzes();
      }
      catch { $('report').innerHTML = '<p>Не удалось загрузить отчёт. Проверьте интернет.</p>'; $('qzRep').innerHTML = ''; }
    }
    $('period').addEventListener('change', loadReport); $('reload').addEventListener('click', loadReport);

    const known = (s: any) => Object.values(s.decks || {}).reduce((a: number, d: any) => a + (d.good || 0) + (d.done || 0), 0) as number;
    const acc = (s: any) => (s.answers ? Math.round(1000 * s.ok / s.answers) / 10 : null);
    const fmtD = (t: string | null) => (t ? new Date(t).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : '—');
    const tr = (deck: string, w: string) => D.dict[deck + '|' + w] || '';
    const COLS: [string, string, (s: any) => any][] = [
      ['name', 'Имя', s => label(s)], ['sex', 'Пол', s => s.sex || ''], ['sessions', 'Входов', s => s.sessions], ['minutes', 'Минут', s => +s.minutes],
      ['days', 'Дней', s => s.days], ['known', 'Знает слов', known], ['answers', 'Ответов', s => s.answers], ['acc', 'Верно %', acc],
      ['bad', 'Ошибок', s => s.bad], ['ct', 'Тесты %', s => s.ct?.avg ?? null], ['qz', 'Викторины %', s => s.qz?.avg ?? null], ['qn', 'Попыток викторин', s => s.qz?.n || 0], ['last', 'Последний вход', s => s.last],
    ];
    function bars(items: { l: string; v: number; s?: string }[], max: number, coral = false) {
      return `<div class="bars">${items.map(x => `<span>${x.l}</span><span class="t"><i class="${coral ? 'c' : ''}" style="width:${max ? Math.max(1, 100 * x.v / max) : 0}%"></i></span><span class="v">${x.s ?? x.v}</span>`).join('')}</div>`;
    }
    function cols(vals: number[], labels: string[]) {
      const m = Math.max(1, ...vals);
      return `<div class="cols">${vals.map((v, i) => `<div title="${labels[i] || i}: ${v} мин." style="height:${100 * v / m}%"></div>`).join('')}</div><div class="cl">${labels.map(l => `<span>${l}</span>`).join('')}</div>`;
    }
    function renderReport() {
      const S = R.learners as any[], act = S.filter(s => +s.minutes > 0 || s.answers > 0);
      const tm = S.reduce((a, s) => a + +s.minutes, 0), ta = S.reduce((a, s) => a + s.answers, 0), tok = S.reduce((a, s) => a + s.ok, 0);
      const top = (k: (s: any) => number | null, unit: string, flt?: (s: any) => boolean, n = 3) => {
        const L = S.filter(flt || (s => (k(s) ?? 0) > 0)).sort((a, b) => (k(b) ?? 0) - (k(a) ?? 0)).slice(0, n);
        return L.length ? L.map(s => `<li>${esc(label(s))} — ${Math.round((k(s) ?? 0) * 10) / 10} ${unit}</li>`).join('') : '<li class="none">пока нет данных</li>';
      };
      const noms: [string, string, string?][] = [
        ['⏱ Больше всех времени', top(s => +s.minutes, 'мин.')], ['📚 Выучил больше слов', top(known, 'сл.')],
        ['🎯 Самый точный (от 50 ответов)', top(acc, '%', s => s.answers >= 50)], ['📅 Больше всех дней занятий', top(s => s.days, 'дн.')],
