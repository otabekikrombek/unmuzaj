    // ---------- сообщения посетителей «Сообщить об ошибке» (только администратор) ----------
    const FA = t.feedbackAdmin;
    let msgs: any[] = [];
    const httpUrl = (s: string) => (/^https?:\/\//i.test(s || '') ? s : ''); // ссылка только на обычный адрес сайта
    const decoded = (s: string) => { try { return decodeURI(s); } catch { return s; } };
    async function loadMsgs() {
      $('msgList').innerHTML = `<p class="muted">${FA.loading}</p>`;
      try {
        const r = await rpc<any>('admin_feedback', { p_status: $<HTMLSelectElement>('msgFilter').value || null });
        if (!r.ok) throw 0;
        msgs = r.rows; $('msgBadge').textContent = String(r.counts.new); $('msgBadge').hidden = !r.counts.new;
        renderMsgs();
      } catch { $('msgList').innerHTML = `<p>${FA.fail}</p>`; }
    }
    function renderMsgs() {
      const act = (st: string, text: string) => `<button class="btn ghost sm" data-st="${st}">${text}</button>`;
      $('msgList').innerHTML = msgs.length ? msgs.map(m => {
        const who = m.nickname ? `${esc(m.nickname)}${m.class ? ` · «${esc(m.class)}»` : ''}` : FA.guest;
        const url = httpUrl(m.page);
        const meta: [string, string][] = [];
        if (m.page) meta.push([FA.page, url ? `<a href="${esc(url)}" target="_blank" rel="noopener">${esc(decoded(m.page))}</a>` : esc(m.page)]);
        if (m.item_label || m.item) meta.push([FA.item, `${m.item_label ? wrapAr(m.item_label) : ''} <small class="muted">${esc(m.item || '')}</small>`]);
        if (m.contact) meta.push([FA.contact, esc(m.contact)]);
        if (m.device) meta.push([FA.device, `<small>${esc(m.device)}</small>`]);
        return `<article class="fbm st-${esc(m.status)}" data-id="${m.id}">
          <p class="fbm-h"><b>№${m.id}</b> · ${fmtD(m.at)} · <span class="fbm-st">${esc((FA.status as Record<string, string>)[m.status] || m.status)}</span> · ${who} · <span class="muted">${m.sent ? FA.sent : FA.notSent}</span></p>
          <p class="fbm-t" dir="auto">${esc(m.message)}</p>
          <dl class="fbm-meta">${meta.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('')}</dl>
          <div class="fbm-a">${m.status === 'new' ? act('read', FA.markRead) : ''}${m.status !== 'fixed' ? act('fixed', FA.markFixed) : ''}${m.status !== 'new' ? act('new', FA.markNew) : ''}${act('delete', FA.del)}</div>
        </article>`;
      }).join('') : `<p class="muted">${FA.empty}</p>`;
    }
    $('msgList').addEventListener('click', async e => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-st]');
