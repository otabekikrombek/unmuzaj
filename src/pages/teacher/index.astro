          <div><h2>Когда занимаются</h2><h3>По дням недели, минуты</h3>${cols(R.weekday, ['пн', 'вт', 'ср', 'чт', 'пт', 'сб', 'вс'])}<h3>По часам, минуты</h3>${cols(R.hour, R.hour.map((_: any, i: number) => (i % 3 === 0 ? String(i) : '')))}</div>
          <div><h2>Последние 30 дней, минуты</h2>${cols(daysArr.map(d => +(R.daily[d] || 0)), daysArr.map((d, i) => (i % 5 === 0 ? d.slice(8) + '.' + d.slice(5, 7) : '')))}
            <h2>Юноши и девушки</h2><div class="tw"><table class="rep"><thead><tr><th>Группа</th><th>Чел.</th><th>Минут</th><th>Знает слов</th><th>Точность %</th><th>Тесты %</th></tr></thead><tbody>
            ${[['м', 'Юноши'], ['ж', 'Девушки']].map(([k, l]) => { const L = grp(k); return `<tr><td>${l}</td><td>${L.length}</td><td>${avg(L, s => +s.minutes)}</td><td>${avg(L, known)}</td><td>${avg(L, s => (s.answers >= 20 ? acc(s) : null))}</td><td>${avg(L, s => s.ct?.avg ?? null)}</td></tr>`; }).join('')}</tbody></table></div>
            ${S.some(s => !s.sex) ? '<p class="note">Не у всех указан пол: заполните его во вкладке «Ученики и ПИН».</p>' : ''}
            <p class="note">В группе около 20 человек, поэтому разница даже в 10–15% может быть случайной. Это описание группы, а не вывод о юношах и девушках.</p></div>
        </div>
        <p class="muted small">Отчёт на ${new Date(R.generated).toLocaleString('ru-RU')}. Подробно о викторинах — во вкладке «Викторины».</p>`;
      table(); words(); themes();
      $('wdeck').addEventListener('change', words); $('tdeck').addEventListener('change', themes);
    }
    function table() {
      const C = COLS.find(c => c[0] === sortK)!;
      const L = (R.learners as any[]).slice().sort((a, b) => { const x = C[2](a), y = C[2](b); if (x == null) return 1; if (y == null) return -1; return (x > y ? 1 : x < y ? -1 : 0) * sortD; });
      $('rep').innerHTML = `<thead><tr><th>№</th>${COLS.map(c => `<th data-k="${c[0]}" tabindex="0">${c[1]}${c[0] === sortK ? (sortD > 0 ? ' ▲' : ' ▼') : ''}</th>`).join('')}</tr></thead><tbody>` +
        L.map((s, i) => `<tr data-id="${s.id}" tabindex="0"><td>${i + 1}</td>${COLS.map(c => { const v = c[2](s); return `<td class="${c[0] === 'name' || c[0] === 'sex' ? '' : 'n'}">${c[0] === 'last' ? fmtD(v) : v == null ? '—' : esc(v)}</td>`; }).join('')}</tr>`).join('') + '</tbody>';
      $('rep').querySelectorAll<HTMLElement>('th[data-k]').forEach(th => { const go = () => { const k = th.dataset.k!; sortD = k === sortK ? -sortD : k === 'name' ? 1 : -1; sortK = k; table(); }; th.addEventListener('click', go); th.addEventListener('keydown', e => { if (e.key === 'Enter') go(); }); });
      $('rep').querySelectorAll<HTMLElement>('tbody tr').forEach(r => { const go = () => detail(+r.dataset.id!); r.addEventListener('click', go); r.addEventListener('keydown', e => { if (e.key === 'Enter') go(); }); });
