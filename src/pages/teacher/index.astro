      ];
      const decks = Object.keys(D.deckNames);
      const daysArr: string[] = []; for (let i = 29; i >= 0; i--) { const d = new Date(Date.now() - i * 864e5); daysArr.push(`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`); }
      const grp = (x: string) => S.filter(s => s.sex === x);
      const avg = (L: any[], f: (s: any) => number | null) => { const v = L.map(f).filter(v => v != null) as number[]; return v.length ? Math.round(10 * v.reduce((a, b) => a + b, 0) / v.length) / 10 : '—'; };
      $('report').innerHTML = `
        <div class="kpis">${[[`${act.length} из ${S.length}`, 'занимались'], [Math.round(tm), 'минут всего'], [act.length ? Math.round(tm / act.length) : 0, 'минут на ученика'], [ta, 'ответов'], [ta ? Math.round(100 * tok / ta) + '%' : '—', 'верных ответов'], [S.reduce((a, s) => a + s.sessions, 0), 'входов']].map(k => `<div class="kpi"><b>${k[0]}</b><span>${k[1]}</span></div>`).join('')}</div>
        <h2>Номинации</h2><div class="noms">${noms.map(n => `<div class="nom ${n[2] || ''}"><h3>${n[0]}</h3><ol>${n[1]}</ol></div>`).join('')}</div>
