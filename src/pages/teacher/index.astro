    const pct = (a: any) => (a.total ? Math.round(100 * a.correct / a.total) : 0);
    const learnerById = (id: number) => (R?.learners as any[] || []).find(l => l.id === id);
    function attemptsTable(list: any[], withName: boolean) {
      if (!list.length) return '<p class="muted">Попыток нет.</p>';
      return `<div class="tw"><table class="rep att"><thead><tr><th>Когда</th>${withName ? '<th>Ученик</th>' : '<th>Викторина</th>'}<th>Верно</th><th>%</th><th>Очки</th><th>Время</th><th>Уровень</th><th></th></tr></thead><tbody>` +
        list.map(a => `<tr><td>${fmtD(a.at)}</td><td>${withName ? esc(label(learnerById(a.learner) || { code: '', nickname: '?' })) : esc(qTitle(a.quiz))}</td><td class="n">${a.correct}/${a.total}</td><td class="n">${pct(a)}%</td><td class="n">${a.points}</td><td class="n">${fmtTime(a.time || 0)}</td><td>${esc(a.level || '')}</td>` +
          `<td><button class="btn ghost sm rvBtn" data-att="${esc(a.id)}">Разбор</button></td></tr>`).join('') + '</tbody></table></div>';
    }
    function bindAttempts(root: HTMLElement) {
      root.querySelectorAll<HTMLButtonElement>('.rvBtn').forEach(b => b.addEventListener('click', e => { e.stopPropagation(); review(b.dataset.att!); }));
    }
    async function review(id: string) {
      const a0 = (QR.attempts as any[]).find(a => a.id === id), L = learnerById(a0?.learner);
      $('dt').textContent = `${L ? label(L) : ''} · ${qTitle(a0?.quiz)}`;
      $('dbody').innerHTML = '<p>Загрузка…</p>'; const dlg = $<HTMLDialogElement>('dlg'); if (!dlg.open) dlg.showModal();
      try {
        const r = await rpc<any>('teacher_quiz_attempt', { p_attempt: id }); if (!r.ok) throw 0;
        const a = r.attempt, m = QM[a.quiz] || { sections: {}, plan: [], explain: {} };
        const secRows = (m.plan as [string, number][]).map(([k]) => { const x = (a.answers as any[]).filter(y => y.s === k); return { s: k, ok: x.filter(y => y.ok).length, n: x.length }; }).filter(x => x.n);
        $('dbody').innerHTML = `<p>${fmtD(a.at)} · верно <b>${a.correct} из ${a.total}</b> (${pct(a)}%) · ${a.points} очков · ${fmtTime(a.time || 0)} · ${esc(a.level || '')}</p>` +
          (secRows.length > 1 ? secBars(m.sections, secRows) : '') + reviewHTML(a.answers, m.sections, t.quiz, m.explain, { quiz: a.quiz, text: t.feedback.inQuestion });
      } catch { $('dbody').innerHTML = '<p>Не удалось загрузить разбор.</p>'; }
    }
    function renderQuizzes() {
      if (!QR?.ok) { $('qzRep').innerHTML = '<p>Нет данных.</p>'; return; }
      const sel = $<HTMLSelectElement>('qzSel'), prev = sel.value;
      const cnt = (k: string) => (QR.attempts as any[]).filter(a => a.quiz === k).length;
      const keys = Object.keys(QM).sort((a, b) => cnt(b) - cnt(a));
      sel.innerHTML = keys.map(k => `<option value="${esc(k)}">${esc(QM[k].title)}${QM[k].kind === 'test' ? ' (тест)' : ''} — попыток: ${cnt(k)}</option>`).join('');
      if (prev && keys.includes(prev)) sel.value = prev;
      quizPart();
    }
    function quizPart() {
      if (!QR || !cur) return;
      const k = $<HTMLSelectElement>('qzSel').value, m = QM[k], A = (QR.attempts as any[]).filter(a => a.quiz === k);
      $<HTMLAnchorElement>('qzBoard').href = `${D.site}board/${k}/?class=${encodeURIComponent(cur.join)}&hours=3`;
      const S = R.learners as any[];
      const per = S.map(s => { const my = A.filter(a => a.learner === s.id); const best = my.slice().sort((x, y) => y.points - x.points)[0]; return { s, n: my.length, best, last: my[0] }; });
      const done = per.filter(p => p.n);
      const avgBest = done.length ? Math.round(done.reduce((x, p) => x + pct(p.best), 0) / done.length) : null;
      const secRows = (m.plan as [string, number][]).map(([s]) => { const x = (QR.sections as any[]).find(y => y.quiz === k && y.s === s); return { s, ok: x?.ok || 0, n: x?.n || 0 }; }).filter(x => x.n);
      const hard = (QR.hard as any[]).filter(h => h.quiz === k).slice(0, 15);
      $('qzRep').innerHTML = `<div class="kpis">${[[`${done.length} из ${S.length}`, 'прошли'], [A.length, 'попыток'], [avgBest == null ? '—' : avgBest + '%', 'средний лучший результат']].map(x => `<div class="kpi"><b>${x[0]}</b><span>${x[1]}</span></div>`).join('')}</div>
        <h2>Ученики</h2><div class="tw"><table class="rep"><thead><tr><th>Имя</th><th>Попыток</th><th>Лучший</th><th>%</th><th>Очки</th><th>Последняя</th><th></th></tr></thead><tbody>` +
        per.sort((a, b) => (b.best?.points ?? -1) - (a.best?.points ?? -1)).map(p => `<tr><td>${esc(label(p.s))}</td><td class="n">${p.n || '—'}</td><td class="n">${p.best ? `${p.best.correct}/${p.best.total}` : '—'}</td><td class="n">${p.best ? pct(p.best) + '%' : '—'}</td><td class="n">${p.best?.points ?? '—'}</td><td>${p.last ? fmtD(p.last.at) : '—'}</td>` +
