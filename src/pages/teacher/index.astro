      $('dbody').innerHTML = `<p>${s.sex === 'м' ? 'юноша · ' : s.sex === 'ж' ? 'девушка · ' : ''}псевдоним «${esc(s.nickname)}» · входов: <b>${s.sessions}</b> · минут: <b>${s.minutes}</b> · дней: <b>${s.days}</b> · ответов: <b>${s.answers}</b> (верно ${acc(s) ?? '—'}%) · последний вход: ${fmtD(s.last)}</p>
        <h3>Слова по наборам</h3><div class="tw"><table class="rep"><thead><tr><th>Набор</th><th>Видел</th><th>Учит</th><th>Знает</th><th>Выучил</th></tr></thead><tbody>${decks}</tbody></table></div>
        <h3>Тесты по словам</h3><p>${s.ct.n ? `${s.ct.n} · средний ${s.ct.avg}% · лучший ${s.ct.best}%` : 'Тестов нет.'}</p>
        <h3>Темы: доля ошибок</h3>${th.length ? bars(th.map(t => ({ l: esc(t.t), v: Math.round(100 * t.bad / t.n), s: `${Math.round(100 * t.bad / t.n)}% из ${t.n}` })), 100, true) : '<p>Нет ответов.</p>'}
        <h3>Самые трудные слова</h3>${s.hard.length ? `<table class="rep"><tbody>${s.hard.map((h: any) => `<tr><td class="ar" lang="ar" dir="rtl">${esc(h.w)}</td><td>${esc(tr(h.deck, h.w))}</td><td class="n">ошибок: ${h.bad}</td></tr>`).join('')}</tbody></table>` : '<p>Ошибок нет.</p>'}
        <h3>Минуты по дням</h3>${days.length ? cols(days.map(d => +s.daily[d]), days.map(d => d.slice(8) + '.' + d.slice(5, 7))) : '<p>Нет занятий.</p>'}
        <h3>Викторины</h3>${attemptsTable((QR?.attempts || []).filter((a: any) => a.learner === s.id), false)}`;
