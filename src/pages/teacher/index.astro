        (L.length ? L.map(w => `<tr><td class="ar" lang="ar" dir="rtl">${esc(w.w)}</td><td>${esc(tr(w.deck, w.w))}<br><small class="muted">${esc(w.t || '')}</small></td><td class="n">${w.studs} чел.</td><td class="n">${w.pct}%</td></tr>`).join('') : '<tr><td colspan="4">Пока ошибок нет.</td></tr>') + '</tbody>';
    }
    function themes() {
      const d = $<HTMLSelectElement>('tdeck').value, L = (R.themes as any[]).filter(t => t.deck === d).sort((a, b) => b.pct - a.pct);
      $('themes').innerHTML = L.length ? bars(L.map(t => ({ l: esc(t.t), v: +t.pct, s: t.pct + '%' })), Math.max(1, ...L.map(t => +t.pct)), true) : '<p class="muted">Пока нет данных.</p>';
    }
    function detail(id: number) {
      const s = (R.learners as any[]).find(x => x.id === id); if (!s) return;
