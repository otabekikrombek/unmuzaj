---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Страница не найдена" noindex>
  <div class="wrap narrow" style="padding:60px 16px">
    <p lang="ar" dir="rtl" class="e404">٤٠٤</p>
    <h1>Такой страницы нет</h1>
    <p>Возможно, адрес изменился. Начните с <a href={u('')}>главной страницы</a> или откройте <a href={u('words/')}>слова</a>.</p>
  </div>
</Base>
<style>.e404 { font-family: var(--ar); font-size: calc(3rem * var(--ar-scale)); color: var(--accent-2); text-align: left; margin: 0; }</style>
