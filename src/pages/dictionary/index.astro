---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import dict from '../../data/dictionary.json';
import { t } from '../../i18n/ru';
const total = dict.reduce((a, g) => a + g.items.length, 0);
---
<Base title={t.nav.dictionary} description="Тематический арабско-русский словарь с поиском: огласовки, множественное число, пары антонимов.">
  <PageHead title={t.nav.dictionary} ar={t.sectionsAr.dictionary} lead={`${total} слов по ${dict.length} темам. Ищите по-русски или по-арабски — с огласовками или без.`} />
  <div class="wrap">
    <label for="q">Поиск</label>
    <input id="q" type="search" placeholder="например: книга, كتاب" autocomplete="off" />
    <p class="muted small" id="cnt" aria-live="polite"></p>
    <div id="dict">
      {dict.map(g => (
        <section class="theme" data-theme>
          <h2>{g.t}</h2>
          <table>
            <tbody>
              {g.items.map(w => (<tr data-s={`${w.r}`} data-a={w.a}><td class="ru">{w.r}</td><td class="ar" lang="ar" dir="rtl">{w.a}</td></tr>))}
            </tbody>
          </table>
        </section>
      ))}
    </div>
  </div>
  <script>
    const strip = (s: string) => s.replace(/[ً-ٰٟـ]/g, '').replace(/[أإآٱ]/g, 'ا').replace(/ى/g, 'ي').replace(/ة/g, 'ه');
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('#dict tr')];
    const keys = rows.map(r => (r.dataset.s!.toLowerCase().replace(/ё/g, 'е') + ' ' + strip(r.dataset.a!)));
    const q = document.getElementById('q') as HTMLInputElement, cnt = document.getElementById('cnt')!;
    function run() {
      const v = strip(q.value.trim().toLowerCase().replace(/ё/g, 'е'));
      let n = 0;
      rows.forEach((r, i) => { const ok = !v || keys[i].includes(v); r.hidden = !ok; if (ok) n++; });
      document.querySelectorAll<HTMLElement>('[data-theme]').forEach(s => { s.hidden = !s.querySelector('tr:not([hidden])'); });
      cnt.textContent = v ? `Найдено: ${n}` : '';
    }
    q.addEventListener('input', run);
  </script>
</Base>
<style>
  .theme { margin-top: 28px; }
  .theme h2 { font-size: 1.25rem; color: var(--teal); border-bottom: 2px solid var(--teal); padding-bottom: 4px; }
  table { width: 100%; border-collapse: collapse; }
  td { padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  td.ar { font-size: 1.45rem; text-align: right; width: 55%; line-height: 1.7; }
  td.ru { color: var(--ink); }
  tr:nth-child(even) td { background: #f8fbfa; }
</style>
