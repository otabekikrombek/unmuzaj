---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import dict from '../../data/dictionary.json';
import { t } from '../../i18n/ru';
import { u } from '../../lib/url';
import { verbFormIndex, verbFor } from '../../lib/verbs';
const verbIdx = await verbFormIndex();
const total = dict.reduce((a, g) => a + g.items.length, 0);
---
<Base title={t.nav.dictionary} description="Тематический арабско-русский словарь с поиском: огласовки, множественное число, пары антонимов.">
  <PageHead title={t.nav.dictionary} ar={t.sectionsAr.dictionary} lead={`${total} слов по ${dict.length} темам. Ищите по-русски или по-арабски — с огласовками или без.`} />
  <div class="wrap">
    <label for="q">Поиск</label>
    <input id="q" type="search" placeholder="например: книга, كتاب" autocomplete="off" />
    <p class="muted small" id="cnt" aria-live="polite"></p>
    <div id="dict">
      {dict.map(g => (
        <section class="theme" data-topic>
          <h2>{g.t}</h2>
          <table>
            <tbody>
              {g.items.map(w => { const vb = verbFor(verbIdx, w.a); return (
                <tr data-s={`${w.r}`} data-a={w.a}><td class="ru">{w.r}{vb && <a class="cj-link" href={u(`conjugation/${vb.key}/`)}>{t.conj.dictLink}: <span lang="ar" dir="rtl">{vb.verb}</span></a>}</td><td class="ar" lang="ar" dir="rtl">{w.a}</td></tr>
              ); })}
            </tbody>
          </table>
        </section>
      ))}
    </div>
  </div>
  <script>
    import { norm } from '../../lib/normalize';
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('#dict tr')];
    const keys = rows.map(r => norm(r.dataset.s! + ' ' + r.dataset.a!));
    const q = document.getElementById('q') as HTMLInputElement, cnt = document.getElementById('cnt')!;
    function run() {
      const v = norm(q.value);
      let n = 0;
      rows.forEach((r, i) => { const ok = !v || keys[i].includes(v); r.hidden = !ok; if (ok) n++; });
      document.querySelectorAll<HTMLElement>("[data-topic]").forEach(s => { s.hidden = !s.querySelector('tr:not([hidden])'); });
      cnt.textContent = v ? `Найдено: ${n}` : '';
    }
    q.addEventListener('input', run);
    // переход из поиска по сайту: /dictionary/?q=книга
    const pre = new URLSearchParams(location.search).get('q');
    if (pre) { q.value = pre; run(); document.querySelector('#dict tr:not([hidden])')?.scrollIntoView({ block: 'center' }); }
  </script>
</Base>
<style>
  .theme { margin-top: 28px; }
  .theme h2 { font-size: 1.25rem; color: var(--accent); border-bottom: 2px solid var(--accent); padding-bottom: 4px; }
  table { width: 100%; border-collapse: collapse; }
  td { overflow-wrap: anywhere; hyphens: auto; }
  td { padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  td.ar { font-size: calc(1.45rem * var(--ar-scale)); text-align: right; width: 55%; line-height: 1.7; }
  td.ru { color: var(--ink); }
  .cj-link { display: inline-flex; align-items: center; gap: 4px; margin-left: 10px; min-height: 32px; font-size: .9rem; }
  .cj-link [lang='ar'] { font-size: calc(1.15rem * var(--ar-scale)); }
  tr:nth-child(even) td { background: var(--stripe); }
  [hidden] { display: none !important; }
  /* узкий экран и крупный шрифт: перевод над арабским словом */
  @media (max-width: 520px) {
    table, tbody, tr, td, td.ar { display: block; width: auto; }
    td.ru { border-bottom: 0; padding-bottom: 0; }
    tr:nth-child(even) { background: var(--stripe); }
    tr:nth-child(even) td { background: transparent; }
  }
</style>
