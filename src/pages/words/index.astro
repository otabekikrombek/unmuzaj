---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ItemList from '../../components/ItemList.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ru';
const decks = (await getCollection('decks')).sort((a, b) => a.data.added.localeCompare(b.data.added));
---
<Base title={t.nav.words} description="Наборы арабских слов с карточками, интервальным повторением и тестом.">
  <PageHead title={t.nav.words} ar={t.sectionsAr.words} lead="Карточки подбирают слова сами: новые и трудные чаще, выученные реже. Без входа прогресс хранится на этом устройстве, после входа — в облаке." />
  <div class="wrap">
    <ItemList items={decks.map(d => ({ title: d.data.title, href: `words/${d.data.key}/`, side: t.common.words(d.data.items.length), meta: d.data.description }))} />
    <p class="muted small" style="margin-top:12px">{t.common.gradually}</p>
  </div>
</Base>
