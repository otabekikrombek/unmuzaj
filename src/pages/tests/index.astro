---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ItemList from '../../components/ItemList.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ru';
const q = (await getCollection('quizzes')).filter(x => x.data.kind === 'test');
const decks = await getCollection('decks');
---
<Base title={t.nav.tests} description="Тесты и пробный экзамен по арабскому языку.">
  <PageHead title={t.nav.tests} ar={t.sectionsAr.tests} lead={t.sectionsDesc.tests} />
  <div class="wrap">
    <ItemList items={[
      ...q.map(x => ({ title: x.data.title, href: `quizzes/${x.data.key}/`, side: x.data.level, meta: x.data.description })),
      ...decks.map(d => ({ title: `Тест по словам: ${d.data.title}`, href: `words/${d.data.key}/#test`, side: '20 вопросов', meta: 'Вопросы выбираются по вашим трудным и новым словам.' })),
    ]} />
  </div>
</Base>
