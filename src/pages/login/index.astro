---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { u } from '../../lib/url';
---
<Base title="Вход" description="Вход на сайт Unmuzaj: для учеников класса и по email." noindex>
  <PageHead title="Вход" ar="الدُّخُولُ" lead="Заниматься можно и без входа. Вход нужен, чтобы прогресс сохранялся в облаке и был виден на любом устройстве." />
  <div class="wrap login">
    <section id="class" class="box">
      <h2>Я из класса</h2>
      <p class="muted small">Код класса, свой код и ПИН дал преподаватель.</p>
      <form id="fClass" novalidate>
        <label for="join">Код класса</label>
        <input id="join" type="text" autocomplete="off" autocapitalize="characters" maxlength="12" placeholder="например, K7MQ2D" required />
        <div class="two">
          <div><label for="code">Мой код</label><input id="code" type="text" inputmode="numeric" maxlength="3" placeholder="07" required /></div>
          <div><label for="pin">ПИН</label><input id="pin" type="password" inputmode="numeric" maxlength="6" placeholder="••••" autocomplete="off" required /></div>
        </div>
        <label class="check"><input type="checkbox" id="rem" checked /> Запомнить меня на этом телефоне <span class="muted small">(на общем компьютере снимите галочку)</span></label>
        <button class="btn" type="submit">Войти в класс</button>
        <p class="msg" id="mClass" role="alert"></p>
      </form>
    </section>
    <section class="box">
      <h2>Вход по email</h2>
      <p class="muted small">Для преподавателей и тех, кто уже зарегистрирован.</p>
      <form id="fMail" novalidate>
        <label for="email">Email</label>
        <input id="email" type="email" autocomplete="email" required />
        <label for="pass">Пароль</label>
        <input id="pass" type="password" autocomplete="current-password" required />
        <button class="btn" type="submit">Войти</button>
        <p class="msg" id="mMail" role="alert"></p>
      </form>
      <p class="muted small">Открытая регистрация по email появится позже. Пока занимайтесь как гость: прогресс сохранится на вашем устройстве.</p>
    </section>
  </div>
  <script type="application/json" id="paths" set:html={JSON.stringify({ words: u('words/'), me: u('me/'), teacher: u('teacher/') })} />
  <script>
    import { classLogin, emailLogin, getWho } from '../../lib/api';
    const P = JSON.parse(document.getElementById('paths')!.textContent!);
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const back = new URLSearchParams(location.search).get('next');
    const params = new URLSearchParams(location.search);
    if (params.get('join')) $('join').value = params.get('join')!;
    if (getWho()) { const m = document.createElement('p'); m.className = 'notice'; m.innerHTML = `Вы уже вошли. <a href="${P.me}">Мой прогресс</a>`; document.querySelector('.login')!.before(m); }

    $('fClass').addEventListener('submit', async e => {
      e.preventDefault();
      const m = $('mClass'), btn = (e.target as HTMLFormElement).querySelector('button')!;
      const join = $('join').value.trim(), code = $('code').value.trim(), pin = $('pin').value.trim();
      if (!join || !code || !/^\d{4,6}$/.test(pin)) { m.textContent = 'Заполните все поля. ПИН — 4 цифры.'; return; }
      btn.disabled = true; m.textContent = 'Проверяю…';
      try {
        const r = await classLogin(join, code, pin, ($('rem') as HTMLInputElement).checked);
        if (r.ok) { location.href = back && back.startsWith('/') ? back : P.words; return; }
        m.textContent = r.err === 'class' ? 'Класс с таким кодом не найден. Проверьте код класса.'
          : r.err === 'locked' ? 'Слишком много неверных попыток. Подождите 10 минут.'
          : 'Неверный код или ПИН. Если забыли ПИН — спросите преподавателя.';
      } catch { m.textContent = 'Нет связи с сервером. Проверьте интернет и попробуйте ещё раз.'; }
      btn.disabled = false;
    });

    $('fMail').addEventListener('submit', async e => {
      e.preventDefault();
      const m = $('mMail'), btn = (e.target as HTMLFormElement).querySelector('button')!;
      btn.disabled = true; m.textContent = 'Проверяю…';
      try {
        const r = await emailLogin($('email').value.trim(), $('pass').value);
        if (r.ok) { location.href = r.role === 'teacher' || r.role === 'admin' ? P.teacher : P.me; return; }
        m.textContent = /Invalid login/i.test(r.err ?? '') ? 'Неверный email или пароль.' : 'Не удалось войти: ' + r.err;
      } catch { m.textContent = 'Нет связи с сервером. Проверьте интернет и попробуйте ещё раз.'; }
      btn.disabled = false;
    });
  </script>
</Base>
<style>
  .login { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
  .box { background: var(--sheet); border: 1px solid var(--line); border-radius: var(--r-m); padding: 20px 20px 12px; }
  .box h2 { font-size: 1.35rem; margin-bottom: 4px; }
  #class { border-top: 4px solid var(--turq); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .check { display: flex; gap: 8px; align-items: flex-start; font-weight: 400; margin: 14px 0; }
  .check input { width: 20px; height: 20px; margin-top: 2px; flex: none; }
  .btn { width: 100%; margin-top: 12px; }
  .msg { min-height: 1.5em; color: var(--bad-ink); margin-top: 10px; }
  .notice { margin: 0 auto 16px; max-width: 1048px; }
  @media (max-width: 760px) { .login { grid-template-columns: 1fr; } }
</style>
