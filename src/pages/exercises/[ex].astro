---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
import { t } from '../../i18n/ru';
export async function getStaticPaths() {
  return (await getCollection('exercises')).map(e => ({ params: { ex: e.data.key }, props: { e: e.data } }));
}
const { e } = Astro.props;
---
<Base title={e.title} description={e.description}>
  <PageHead title={e.title} ar={t.sectionsAr.exercises} lead={e.description} />
  <div class="wrap narrow">
    {e.legacy && <><p><a class="btn" href={u(e.legacy)}>Начать</a></p><p class="notice">{t.common.oldVersion}</p></>}
  </div>
</Base>
