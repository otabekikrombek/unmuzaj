---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ItemList from '../../components/ItemList.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ru';
const x = (await getCollection('exercises')).sort((a, b) => a.data.added.localeCompare(b.data.added));
---
<Base title={t.nav.exercises} description="Интерактивные упражнения по арабской грамматике.">
  <PageHead title={t.nav.exercises} ar={t.sectionsAr.exercises} lead={t.sectionsDesc.exercises} />
  <div class="wrap"><ItemList items={x.map(e => ({ title: e.data.title, href: `exercises/${e.data.key}/`, side: e.data.level, meta: e.data.description }))} /></div>
</Base>
