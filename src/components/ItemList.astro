---
import { u } from '../lib/url';
interface Item { title: string; href: string; meta?: string; side?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<ul class="list">
  {items.map(i => (
    <li><a class="row" href={u(i.href)}><span class="row-title">{i.title}</span>{i.side && <span class="row-side">{i.side}</span>}{i.meta && <span class="row-meta">{i.meta}</span>}</a></li>
  ))}
</ul>
