---
// Шапка страницы: крошки, название по-арабски, заголовок, пояснение.
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { title: string; ar?: string; lead?: string; parent?: { label: string; href: string }; crumbs?: boolean }
const { title, ar, lead, parent, crumbs = true } = Astro.props;
---
<div class="page-head">
  <div class="wrap">
    {crumbs && <Breadcrumbs title={title} parent={parent} />}
    {ar && <span class="ar ph-ar" lang="ar" dir="rtl">{ar}</span>}
    <h1>{title}</h1>
    {lead && <p class="muted lead">{lead}</p>}
    <slot />
  </div>
</div>
<style>
  .ph-ar { margin-top: 14px; }
  .lead { max-width: 60ch; }
</style>
