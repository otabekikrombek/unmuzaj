---
// Страница-переадресация со старого адреса (src/config/moved.mjs): сразу на новый адрес
// с сохранением ?параметров и #якоря. Закрыта от поиска, нет в sitemap; canonical — новый адрес.
// GitHub Pages не умеет отвечать 301; для Cloudflare те же правила — в public/_redirects.
import '../styles/tokens.css';
import { useI18n } from '../i18n';
interface Props { to: string }
const { to } = Astro.props;
const { t, l } = useI18n(Astro.url);
const href = l(to);
const abs = new URL(href, Astro.site).href;
---
<!doctype html>
<html lang={t.meta.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.moved.title}</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={abs} />
  <script is:inline define:vars={{ href }}>location.replace(href + location.search + location.hash);</script>
  <meta http-equiv="refresh" content={`0; url=${href}`} />
</head>
<body>
  <main>
    <h1>{t.moved.title}</h1>
    <p>{t.moved.text} <a href={href}>{abs}</a></p>
  </main>
</body>
</html>
<style>
  body { font: 1.1rem/1.5 var(--sans); margin: 0; padding: 32px 16px; background: var(--paper); color: var(--ink); }
  a { color: var(--link); overflow-wrap: anywhere; }
</style>
